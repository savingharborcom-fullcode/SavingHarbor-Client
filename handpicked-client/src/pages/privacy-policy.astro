---
// src/pages/privacy-policy.astro
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const pageMeta = {
  title: "Privacy Policy | Saving Harbor",
  description:
    "Official Privacy Policy explaining how Saving Harbor collects, uses, stores, and protects personal information.",
};

const privacySchema = {
  "@context": "https://schema.org",
  "@type": "PrivacyPolicy",
  name: "Privacy Policy",
  url: "https://www.savingharbor.com/privacy-policy",
  publisher: {
    "@type": "Organization",
    name: "Saving Harbor",
    url: "https://www.savingharbor.com",
  },
};
---

<Base meta={pageMeta}>
  <Header />

  <main role="main" aria-labelledby="privacy-heading" class="container mx-auto px-4 py-10">
    <header id="privacy-heading" class="mb-6">
      <h1 class="site-hero text-on-surface">Privacy Policy</h1>
      <p class="mt-2 text-gray-400">
        Effective Date: {new Date().toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
      </p>
    </header>

    <section class="card card-surface p-6 space-y-6">

      <p>
        Saving Harbor respects your privacy and is committed to protecting the information you share with us. This Privacy Policy explains how we collect, use, store, and safeguard information when you access or use SavingHarbor.com and related services.
      </p>

      <h2 class="section-heading">Information We Collect</h2>

      <p>
        We may collect information that you voluntarily provide, such as email addresses submitted for inquiries, support, or partnerships. We also collect certain technical and usage information automatically, including browser type, device information, IP address, approximate geographic location, referral source, and interaction data such as pages viewed and time spent on the site.
      </p>

      <h2 class="section-heading">How We Use Information</h2>

      <p>
        Information collected is used to operate and improve our website, enhance user experience, analyze site performance, prevent misuse, and deliver relevant promotional content. We may use aggregated and anonymized data to evaluate trends and measure the effectiveness of our content and affiliate partnerships.
      </p>

      <h2 class="section-heading">Affiliate & Advertising Disclosure</h2>

      <p>
        Saving Harbor participates in affiliate programs and may earn commissions from qualifying purchases. Third-party advertising partners may use cookies or similar technologies to deliver relevant advertisements and measure performance. We do not sell personal information to third parties.
      </p>

      <h2 class="section-heading">Cookies & Tracking Technologies</h2>

      <p>
        We use cookies and similar technologies to enhance website functionality, understand user behavior, and improve overall performance. You may control cookies through your browser settings. Disabling cookies may impact certain features of the site.
      </p>

      <h2 class="section-heading">Data Retention</h2>

      <p>
        We retain personal information only as long as necessary to fulfill the purposes described in this policy, comply with legal obligations, resolve disputes, and enforce agreements.
      </p>

      <h2 class="section-heading">User Rights</h2>

      <p>
        Depending on your jurisdiction, you may have the right to request access to, correction of, or deletion of your personal information. You may also have the right to object to certain data processing activities. Requests can be submitted using the contact information below.
      </p>

      <h2 class="section-heading">Children’s Privacy</h2>

      <p>
        Saving Harbor does not knowingly collect personal information from children under the age of 13. If we become aware that such information has been collected, we will take appropriate steps to delete it.
      </p>

      <h2 class="section-heading">Third-Party Links</h2>

      <p>
        Our website may contain links to third-party websites. We are not responsible for the privacy practices or content of those sites. Users should review the privacy policies of any external websites visited.
      </p>

      <h2 class="section-heading">Security</h2>

      <p>
        We implement reasonable technical and organizational measures to protect information against unauthorized access, disclosure, or misuse. While no online system can guarantee absolute security, we strive to maintain a secure environment.
      </p>

      <h2 class="section-heading">Policy Updates</h2>

      <p>
        This Privacy Policy may be updated periodically to reflect changes in practices, technology, or legal requirements. Continued use of the website after updates constitutes acceptance of the revised policy.
      </p>

      <h2 class="section-heading">Contact</h2>

      <p>
        For questions regarding this Privacy Policy, please contact:
        <br />
        <strong>Email:</strong>
        <a href="mailto:support.savingharbor@gmail.com" class="text-brand-primary hover:underline">
          support.savingharbor@gmail.com
        </a>
      </p>

    </section>

    <script type="application/ld+json" set:html={JSON.stringify(privacySchema)} />
  </main>

  <Footer />
</Base>
