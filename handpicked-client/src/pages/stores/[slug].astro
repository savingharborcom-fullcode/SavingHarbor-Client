---
/* src/pages/stores/[slug].astro
   - Hero: compact stacked layout (logo + title + meta + actions)
   - Descriptions: ExpandableText islands inline with View more… / Show less
   - Sidebar: sticky at top (unchanged)
*/
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CardStore from "../../components/CardStore.astro";
import MerchantProofsIsland from "../../components/islands/MerchantProofsIsland.jsx";
import CouponRevealIsland from "../../components/islands/CouponRevealIsland.astro";
import SubscribeBox from "../../components/SubscribeBox.jsx";
import FaqAccordion from "../../components/FAQAccordion.jsx";
import RecentActivity from "../../components/RecentActivity.jsx";
import TrendingOffersCompact from "../../components/TrendingOffersCompact.jsx";
import WhyTrustUs from "../../components/WhyTrustUs.jsx";
import ExpandableText from "../../components/ExpandableText.jsx";
import { api } from "../../lib/api";
import SavingsImpact from "../../components/SavingsImpact.astro";
import FeedbackForm from "../../components/islands/FeedbackForm.jsx";
import VerifiedBadge from "../../components/VerifiedBadge.astro";

type Coupon = {
  id: string | number;
  title?: string | null;
  coupon_type?: string | null;
  ends_at?: string | null;
  merchant_name?: string | null;
  discount_type?: string | null;
  discount_value?: string | null;
  merchant?: {
    slug?: string | null;
    logo_url?: string | null;
    affl_url?: string | null;
    web_url?: string | null;
  };
};

type StoreDetail = {
  id: number | string;
  slug: string;
  name: string;
  verifier_id?: number | string | null;
  logo_url?: string | null;
  web_url?: string | null;
  aff_url?: string | null;
  category_names?: string[];
  side_description_html?: string | null;
  description_html?: string | null;
  about_html?: string | null;
  breadcrumbs?: { name: string; url: string }[];
  coupon_h2_blocks?: string[];
  coupon_h3_blocks?: string[];
  stats?: { active_coupons?: number };
  coupons?: {
    items: Coupon[];
    page?: number;
    limit?: number;
    total?: number;
    prev?: string | null;
    next?: string | null;
    total_pages?: number;
  };
  related_stores?: { id: string | number; name: string; slug: string; logo_url?: string | null }[];
  faqs?: { question: string; answer: string }[];
  testimonials?: { id: string; user_name: string; rating: number; comment: string; avatar_url?: string; posted_at?: string }[];
  avg_rating?: number | null;
  reviews_count?: number;
  trending_offers?: any[];
  recent_activity?: { total_offers_added_last_30d: number; recent: any[] };
  trust_text?: string | null;
  subscribe_info?: { endpoint: string; required_fields: string[] };
  verifier?: {
    id: number | string;
    name: string;
    slug: string;
    verifying_since?: string;
    avatar_url?: string | null;
    designation: string;
    same_as?: { type: string; url: string }[];
    created_at: string;
  };
};

type StoreDetailResponse = {
  data: StoreDetail | null;
  meta?: {
    canonical?: string;
    jsonld?: any;
    title?: string;
    description?: string;
  };
};

// Seeded deterministic pseudo-random (0–1)
function seededRandom(seed: number): number {
  const x = Math.sin(seed) * 10000;
  return x - Math.floor(x);
}

// Convert slug to numeric seed
function slugToSeed(slug: string): number {
  return slug.split("").reduce((acc, char) => acc + char.charCodeAt(0), 0);
}

const { slug } = Astro.params as { slug: string };

let resp: StoreDetailResponse | null = null;
try {
  // Fixed: was ?limit100 (missing =)
  resp = await api.get<StoreDetailResponse>(`/stores/${slug}?limit=100`, {}, { retries: 2, timeout: 8000 });
} catch (e) {
  console.error("Error fetching store detail:", e);
  resp = { data: null, meta: { title: "Store - Saving Harbor", description: "Store details unavailable." } };
}
const store = resp?.data || null;

// Dynamic breadcrumbs if referred from category page
const refType = Astro.url.searchParams.get("ref");
const parentSlug = Astro.url.searchParams.get("parent");
const subSlug = Astro.url.searchParams.get("sub");

let breadcrumbs = store?.breadcrumbs;

if (store && refType === "category" && parentSlug && subSlug) {
  const apiUrl = import.meta.env.PUBLIC_API_BASE_URL;
  try {
    const res = await fetch(`${apiUrl}/categories/${parentSlug}/${subSlug}`);
    const catData = await res.json();
    if (catData?.data) {
      breadcrumbs = [
        { name: "Home", url: "/" },
        { name: "Categories", url: "/categories" },
        { name: catData.data.parent.name, url: `/categories/${parentSlug}` },
        { name: catData.data.subcategory.name, url: `/categories/${parentSlug}/${subSlug}` },
        { name: store.name, url: `/stores/${store.slug}` },
      ];
    }
  } catch (e) {
    console.error("Breadcrumb category fetch failed:", e);
  }
}

const meta = resp?.meta || {};
const pageTitle = meta?.title || (store?.name ? `${store.name} - Saving Harbor` : "Store - Saving Harbor");
const pageDesc =
  meta?.description ||
  (store?.name ? `Saving Harbor coupons and deals for ${store.name}.` : "Saving Harbor store coupons and deals.");
const canonical = meta?.canonical;
const jsonld = meta?.jsonld;

const safeSideHtml = store?.about_html || null;
const safeDescriptionHtml = store?.description_html || null;

const activeCoupons = store?.stats?.active_coupons || 0;
const minSavings = activeCoupons * 100;
const maxSavings = minSavings + 100;

// Deterministic values seeded from slug — same output on every request
const seed = store ? slugToSeed(store.slug) : 0;

const totalSavings =
  activeCoupons > 0
    ? Math.floor(seededRandom(seed + 2) * (maxSavings - minSavings + 1)) + minSavings
    : 0;

const verifier = store?.verifier;

const lastVerified = verifier
  ? `${Math.floor(seededRandom(seed) * 11) + 2} hours ago`
  : undefined;

const successRate = Math.floor(seededRandom(seed + 1) * 7) + 92;

// Server-side fetch proofs
let proofs: { image_url: string }[] = [];
try {
  const res = await api.get<{ proofs: { image_url: string }[] }>(`/stores/${store?.id}/proofs`);
  console.log("proofs received ::: ", res);
  proofs = res.proofs || [];
} catch (e) {
  console.error("Error fetching proofs:", e);
}

if (jsonld?.["@graph"]) {
  const storeUrl = `https://www.savingharbor.com/stores/${store?.slug}`;

  // Patch #savings-impact value
  const savingsNode = jsonld["@graph"].find(
    (n: any) => n["@id"]?.endsWith("#savings-impact")
  );
  if (savingsNode) savingsNode.value = String(totalSavings);

  // Remove any existing proof nodes built with empty/stale data on the backend
  jsonld["@graph"] = jsonld["@graph"].filter(
    (n: any) => !n["@id"]?.includes("#verification-proof-")
  );

  // Inject one node per proof (indexed)
  proofs.forEach((proof, i) => {
    if (!proof?.image_url) return;
    jsonld["@graph"].push({
      "@type": "ImageObject",
      "@id": `${storeUrl}/#verification-proof-${i + 1}`,
      about: { "@id": `${storeUrl}/#merchant` },
      name: `Coupon Verification Proof ${i + 1}`,
      description: "Checkout screenshot showing successful coupon application.",
      contentUrl: proof.image_url,
    });
  });
}

// Fixed: no more (store as any) casts — aff_url and web_url are in StoreDetail type
const visitUrl = store?.aff_url || store?.web_url || null;
---

<style>
/* fallback clamp utilities if tailwind line-clamp plugin isn't available */
.clamp-1, .clamp-2, .clamp-3 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.clamp-1 { -webkit-line-clamp: 1; }
.clamp-2 { -webkit-line-clamp: 2; }
.clamp-3 { -webkit-line-clamp: 3; }
</style>

<Base meta={{ title: pageTitle, description: pageDesc, canonical, jsonld, og_image: store?.logo_url }}>
  <Header />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    {store ? (
      <>
        <Breadcrumbs breadcrumbs={breadcrumbs} />

        <!-- Hero: left column wider (flexible) + right column for descriptions -->
        <section class="mt-4">
          <div class="grid grid-cols-1 md:grid-cols-[minmax(220px,420px)_1fr] gap-2 md:gap-6 items-start">
            <!-- LEFT: grouped logo + title/meta/actions -->
            <div>
              <div class="flex items-start gap-4">
                <!-- logo -->
                <div class="w-28 h-28 flex items-center justify-center border rounded-lg bg-white shadow-sm overflow-hidden flex-shrink-0">
                  {store.logo_url ? (
                    <img
                      src={store.logo_url}
                      alt={store.name}
                      width="112"
                      height="112"
                      class="object-contain max-h-full max-w-full"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div class="text-sm text-gray-400">Logo</div>
                  )}
                </div>

                <!-- title + meta -->
                <div class="min-w-0">
                  <h1 class="text-2xl font-extrabold text-brand-primary leading-tight">
                    {store.name}
                  </h1>

                  <div class="mt-1 text-sm text-gray-500">
                    {store.category_names && store.category_names.length > 0 ? store.category_names.join(", ") : null}
                  </div>

                  {store.stats?.active_coupons !== undefined && (
                    <div class="mt-2">
                      <span class="pill pill-green">
                        All {store.coupons?.total || 0} coupons loaded
                      </span>
                    </div>
                  )}

                  <div class="mt-3">
                    <a href={`/stores/${store.slug}#about-section`} class="btn btn-outline--light text-sm">About</a>
                  </div>
                </div>
              </div>
            </div>

            <!-- RIGHT: descriptions -->
            <div class="min-w-0">
              {meta.description && (
                <ExpandableText
                  client:load
                  html={meta.description}
                  id="store-meta-desc"
                  initialLines={2}
                  className="text-gray-900 text-[17px] leading-relaxed mb-3 font-semibold"
                />
              )}
            </div>
          </div>
        </section>

        <div class="mt-10 grid grid-cols-1 lg:grid-cols-3 gap-8">
          <!-- Main content -->
          <div class="lg:col-span-2 space-y-8">
            <!-- Merchant proofs -->
            <MerchantProofsIsland client:visible proofs={proofs as any} visitUrl={visitUrl as any} />

            <!-- Coupons -->
            <section id="coupons">
              <h2 class="section-heading">Coupons & Deals</h2>
              {store.coupons?.items && store.coupons.items.length > 0 ? (
                <div class="flex flex-col gap-3">
                  {store.coupons.items.map((c) => (
                    <div class="w-full card-base p-0">
                      <CouponRevealIsland client:visible coupon={c} storeSlug={store.slug} affiliateUrl={visitUrl}/>
                    </div>
                  ))}
                </div>
              ) : (
                <p class="text-gray-500">No active coupons at the moment.</p>
              )}
            </section>

            <!-- About Store -->
            <section id="about-section" class="card-base p-6">
              <h2 class="section-heading">About this store</h2>
              {safeDescriptionHtml ? (
                <div class="prose max-w-none ql-editor merchant-description" set:html={safeDescriptionHtml}></div>
              ) : store.about_html ? (
                <div class="prose max-w-none ql-editor merchant-description" set:html={store.about_html}></div>
              ) : (
                <p class="text-gray-500">No detailed description available for this store.</p>
              )}
            </section>

            <!-- FAQs -->
            {store.faqs && store.faqs.length > 0 && (
              <section id="faqs-section" class="card-base p-6">
                <FaqAccordion client:load faqs={store.faqs} />
              </section>
            )}

            <!-- Related Stores -->
            {store.related_stores && store.related_stores.length > 0 && (
              <section>
                <h2 class="section-heading">Similar stores</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                  {store.related_stores.map((rs) => (
                    <CardStore store={rs} />
                  ))}
                </div>
              </section>
            )}
          </div>

          <!-- Sidebar -->
          <aside class="lg:col-span-1 lg:sticky lg:top-4 lg:self-start space-y-6">
            {verifier && (
              <div class="sidebar-box">
                <VerifiedBadge
                  name={verifier.name}
                  designation={verifier.designation}
                  authorSlug={verifier.slug}
                  avatarUrl={verifier.avatar_url}
                  lastVerified={lastVerified ?? ""}
                  successRate={successRate}
                  verifyingSince={verifier.verifying_since}
                  sameAs={verifier?.same_as ?? []}
                />
              </div>
            )}
            <div class="sidebar-box">
              <SavingsImpact
                totalSavings={totalSavings}
                activeCoupons={activeCoupons}
              />
            </div>
            <div class="sidebar-box">
              <WhyTrustUs client:load />
            </div>
            <div class="sidebar-box">
              <RecentActivity client:load data={store.recent_activity} />
            </div>
            <div class="sidebar-box">
              <TrendingOffersCompact client:load offers={store.trending_offers} storeSlug={store.slug} />
            </div>
            <div class="sidebar-box">
              <div class="card-base p-4">
                <h3 class="text-lg font-semibold text-brand-secondary mb-3">Get updates</h3>
                <SubscribeBox client:load source={store.slug} />
              </div>
            </div>
            <div class="sidebar-box">
              <FeedbackForm client:load storeSlug={store.slug} />
            </div>

            {store.trust_text && (
              <div class="sidebar-box text-sm text-gray-700">
                {store.trust_text}
              </div>
            )}
          </aside>
        </div>
      </>
    ) : (
      <section class="py-20 text-center">
        <h1 class="text-2xl font-bold text-brand-primary">Store not found</h1>
        <p class="text-gray-600 mt-2">Please check the URL or browse all stores.</p>
        <div class="mt-4">
          <a href="/stores" class="px-4 py-2 rounded border border-brand-primary text-brand-primary hover:bg-brand-primary hover:text-white transition">
            Back to Stores
          </a>
        </div>
      </section>
    )}
  </main>

  <Footer />
</Base>