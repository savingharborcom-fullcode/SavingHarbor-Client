---
// src/pages/terms-and-conditions.astro
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const pageMeta = {
  title: "Terms & Conditions | Saving Harbor",
  description:
    "Review the official Terms and Conditions governing the use of SavingHarbor.com, including user responsibilities, affiliate disclosures, and legal limitations.",
};

const termsSchema = {
  "@context": "https://schema.org",
  "@type": "TermsOfService",
  name: "Terms and Conditions",
  url: "https://www.savingharbor.com/terms-and-conditions",
  publisher: {
    "@type": "Organization",
    name: "Saving Harbor",
    url: "https://www.savingharbor.com",
  },
};
---

<Base meta={pageMeta}>
  <Header />

  <main role="main" aria-labelledby="terms-heading" class="container mx-auto px-4 py-10">
    <header id="terms-heading" class="mb-6">
      <h1 class="site-hero text-on-surface">Terms & Conditions</h1>
      <p class="mt-2 text-gray-400">
        Effective Date: {new Date().toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
      </p>
    </header>

    <section class="card card-surface p-6 space-y-6">

      <p>
        These Terms and Conditions govern your access to and use of SavingHarbor.com. By accessing or using this website, you agree to be bound by these terms. If you do not agree with any part of these Terms, you should discontinue use of the website.
      </p>

      <h2 class="section-heading">Use of the Website</h2>

      <p>
        Saving Harbor provides informational content, promotional offers, and affiliate links to third-party merchants. You agree to use the website only for lawful purposes and in a manner that does not violate applicable laws or infringe upon the rights of others.
      </p>

      <h2 class="section-heading">Affiliate Relationships</h2>

      <p>
        Saving Harbor participates in affiliate marketing programs and may earn commissions when users click on links or make qualifying purchases. Transactions are completed directly with third-party merchants, and Saving Harbor is not a party to those transactions.
      </p>

      <h2 class="section-heading">Accuracy of Information</h2>

      <p>
        While we strive to ensure that coupon codes, discounts, and promotional details are accurate and current, we do not guarantee their validity, availability, or effectiveness. Merchants may modify or terminate offers at any time without notice.
      </p>

      <h2 class="section-heading">Third-Party Websites</h2>

      <p>
        The website contains links to third-party websites and services. Saving Harbor does not control and is not responsible for the content, policies, pricing, fulfillment, or practices of third-party merchants. Your interactions with those merchants are governed by their own terms and policies.
      </p>

      <h2 class="section-heading">Intellectual Property</h2>

      <p>
        All content on SavingHarbor.com, including text, design, graphics, branding, and logos, is the property of Saving Harbor or its licensors and is protected by applicable intellectual property laws. Unauthorized reproduction or distribution is prohibited.
      </p>

      <h2 class="section-heading">Limitation of Liability</h2>

      <p>
        Saving Harbor provides the website and its content on an “as is” and “as available” basis. To the fullest extent permitted by law, we disclaim all warranties, express or implied. Saving Harbor shall not be liable for any indirect, incidental, special, consequential, or punitive damages arising from your use of the website or reliance on its content.
      </p>

      <h2 class="section-heading">Indemnification</h2>

      <p>
        You agree to indemnify and hold harmless Saving Harbor, its affiliates, and partners from any claims, liabilities, damages, or expenses arising from your misuse of the website or violation of these Terms.
      </p>

      <h2 class="section-heading">Termination</h2>

      <p>
        We reserve the right to restrict or terminate access to the website at our discretion, without notice, for conduct that we believe violates these Terms or is otherwise harmful to the website or its users.
      </p>

      <h2 class="section-heading">Governing Law</h2>

      <p>
        These Terms shall be governed and interpreted in accordance with the laws applicable in the jurisdiction where Saving Harbor operates, without regard to conflict of law principles.
      </p>

      <h2 class="section-heading">Changes to Terms</h2>

      <p>
        Saving Harbor may update these Terms and Conditions periodically. Continued use of the website after changes are posted constitutes acceptance of the revised Terms.
      </p>

      <h2 class="section-heading">Contact</h2>

      <p>
        For questions regarding these Terms and Conditions, please contact:
        <br />
        <strong>Email:</strong>
        <a href="mailto:support.savingharbor@gmail.com" class="text-brand-primary hover:underline">
          support.savingharbor@gmail.com
        </a>
      </p>

    </section>

    <script type="application/ld+json" set:html={JSON.stringify(termsSchema)} />
  </main>

  <Footer />
</Base>
