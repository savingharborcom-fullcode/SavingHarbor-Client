---
// src/pages/categories/[parentSlug]/[subSlug].astro
import Base from "../../../layouts/Base.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import SubcategoryMerchants from "../../../components/SubcategoryMerchants.jsx";

const { parentSlug, subSlug } = Astro.params;

const apiUrl = import.meta.env.PUBLIC_API_BASE_URL;

// Fetch subcategory data for SSR
let subcategoryData = null;
let errorMessage = null;

try {
  const response = await fetch(
    `${apiUrl}/categories/${parentSlug}/${subSlug}?limit=20`,
  );

  if (response.ok) {
    const result = await response.json();
    subcategoryData = result.data;
  } else {
    errorMessage = "Subcategory not found";
  }
} catch (error) {
  console.error("Error fetching subcategory:", error);
  errorMessage = "Failed to load subcategory";
}

// Return 404 if not found
if (!subcategoryData) {
  return Astro.redirect("/404");
}

const pageTitle =
  subcategoryData.subcategory.meta_title ||
  `${subcategoryData.subcategory.name} Stores - ${subcategoryData.parent.name}`;
const pageDesc =
  subcategoryData.subcategory.meta_description ||
  `Browse ${subcategoryData.subcategory.name} stores and find the best coupons and deals.`;
const canonical = `https://www.savingharbor.com/categories/${parentSlug}/${subSlug}`;
---

<Base meta={{ title: pageTitle, description: pageDesc, canonical }}>
  <Header />

  <main class="container mx-auto px-4 py-10">
    <!-- Breadcrumb -->
    <nav class="mb-6 text-sm text-gray-600">
      <ol class="flex items-center space-x-2">
        <li>
          <a href="/categories" class="hover:text-brand-primary">Categories</a>
        </li>
        <li>/</li>
        <li>
          <a
            href={`/categories/${parentSlug}`}
            class="hover:text-brand-primary"
          >
            {subcategoryData.parent.name}
          </a>
        </li>
        <li>/</li>
        <li class="text-gray-900 font-medium">
          {subcategoryData.subcategory.name}
        </li>
      </ol>
    </nav>

    <!-- Header -->
    <!-- Hero -->
    <section class="mt-8">
      {
        subcategoryData.subcategory.thumb_url && (
          <div class="w-full h-48 md:h-64 bg-gradient-to-r from-blue-50 to-indigo-100 rounded-2xl overflow-hidden mb-6">
            <img
              src={subcategoryData.subcategory.thumb_url}
              alt={subcategoryData.subcategory.name}
              class="w-full h-full object-contain p-4"
            />
          </div>
        )
      }
      <div class="text-center md:text-left">
        <h1
          class="text-4xl md:text-5xl font-extrabold text-brand-primary leading-tight mb-4"
        >
          {subcategoryData.subcategory.name}
        </h1>
        {
          subcategoryData.subcategory.description && (
            <div class="max-w-2xl mx-auto md:ml-0 text-lg text-gray-600 mb-8">
              {subcategoryData.subcategory.description}
            </div>
          )
        }
        <div class="flex flex-wrap gap-4 justify-center md:justify-start">
          <span class="pill pill-green">
            {subcategoryData.pagination.total} stores
          </span>
          <span class="pill pill-blue">
            {subcategoryData.parent.name}
          </span>
        </div>
      </div>
    </section>
    <!-- Merchants Grid (Client-side with pagination) -->
    <SubcategoryMerchants
      client:load
      apiUrl={apiUrl}
      parentSlug={parentSlug}
      subSlug={subSlug}
      initialData={subcategoryData}
    />
  </main>

  <Footer />
</Base>
